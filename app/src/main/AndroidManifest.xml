<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        An entry's coordinates are only saved on a button press, so permission is asked
        for there rather than at startup. The precise one pins the very place the money
        went; the approximate one is the fallback when that is all a person granted.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        The app keeps everything a person enters on the device, and nothing it holds ever
        leaves. This is for the one button that fetches an exchange rate: it sends two
        currency codes and a date and receives a number. Everything else works with the
        network off.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Asked for on the one button that copies an event out of the calendar into a new
        one of ours, and never otherwise. Nothing is written back and nothing is read
        until that button is pressed, so somebody who never presses it is never asked.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JourJour">

        <!--
            Drawn edge to edge, the window is not shrunk for the keyboard; without this the
            system pans the whole window instead, cutting the top of the screen off. The
            screens make room for the keyboard themselves; see ui/common/Insets.kt.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.JourJour">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands the camera a link to one receipt file at a time. The CAMERA permission
            is deliberately not declared: an app that declares it must also hold it before
            the system will start a capture intent, and taking a photo through the camera
            app needs no permission at all.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
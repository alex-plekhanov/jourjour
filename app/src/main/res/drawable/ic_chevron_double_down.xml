<!--
    Two chevrons pointing down: the entry form's "show the rest of the fields" control.
    Drawn by hand because the double chevron lives in the extended icon set, and pulling
    that in for one glyph would cost far more than the file.

    Rotated half a turn by the caller to mean the opposite, so there is no second file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="@android:color/transparent"
      android:strokeColor="@android:color/white"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M6.5,7 L12,12.5 L17.5,7" />
  <path
      android:fillColor="@android:color/transparent"
      android:strokeColor="@android:color/white"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M6.5,13 L12,18.5 L17.5,13" />
</vector>

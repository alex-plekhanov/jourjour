<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the receipts folder is shared, and only through a content:// link the camera or
    another app is handed for one file at a time. The rest of the app's storage stays
    unreachable from outside.
-->
<paths>
    <files-path name="receipts" path="receipts/" />
    <!--
        Where a sheet of the schedule is written on its way out to another app. The cache,
        because the file exists only for the length of a share and the system is welcome
        to sweep it up afterwards.
    -->
    <cache-path name="share" path="share/" />
</paths>
